#! /usr/bin/env bash

function _which() {
  command -v "$1" > /dev/null 2>&1
}

function _environmart_has_executable() {
  if [[ -n "${ZSH_VERSION:-}" ]]; then
    whence -p "$1" > /dev/null 2>&1
  else
    type -P "$1" > /dev/null 2>&1
  fi
}

function _punt() {
  echo "$1"
  return 1
}

#############################################################################
# Lightweight shell setup
#############################################################################

# Installation and upgrades are intentionally not run while the shell starts.
if _which prettyping; then
  alias ping='prettyping --nolegend'
fi

#############################################################################
# Explicit workstation maintenance
#############################################################################

_environmart_brew_formulae='awscli bat bitwarden-cli cloudflared coreutils gh git git-delta go granted jq spacectl telnet tenv the_silver_searcher wireguard-tools'
_environmart_brew_casks='balenaetcher docker firefox flycut google-chrome iterm2 licecap microsoft-office notion postman powershell raycast rectangle slack visual-studio-code vlc windows-app zoom'
_environmart_brew_taps='common-fate/granted spacelift-io/spacelift'

_environmart_ensure_brew() {
  local brew_path

  if _which brew; then
    return 0
  fi

  for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "${brew_path}" ]; then
      eval "$(${brew_path} shellenv)"
      return 0
    fi
  done

  if [[ "${OSTYPE:-}" == darwin* ]]; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || return 1
    for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew; do
      if [ -x "${brew_path}" ]; then
        eval "$(${brew_path} shellenv)"
        return 0
      fi
    done
  fi

  echo "Homebrew is not installed."
  return 1
}

_environmart_install_formula() {
  local formula="$1"

  if ! brew list --formula "${formula}" > /dev/null 2>&1; then
    brew install "${formula}"
  fi
}

_environmart_install_cask() {
  local cask="$1"

  if ! brew list --cask "${cask}" > /dev/null 2>&1; then
    brew install --cask "${cask}"
  fi
}

_environmart_install_brew_tools() {
  local item

  _environmart_ensure_brew || return 1

  for item in ${_environmart_brew_taps}; do
    if ! brew tap-info --installed "${item}" > /dev/null 2>&1; then
      brew tap "${item}" || return 1
    fi
  done

  for item in ${_environmart_brew_formulae}; do
    _environmart_install_formula "${item}" || return 1
  done

  for item in ${_environmart_brew_casks}; do
    _environmart_install_cask "${item}" || return 1
  done
}

_environmart_install_prettyping() {
  local target="${HOME}/.local/bin/prettyping"

  _which prettyping && return 0
  mkdir -p "${HOME}/.local/bin" || return 1
  curl -fsSL https://raw.githubusercontent.com/denilsonsa/prettyping/master/prettyping -o "${target}" || return 1
  chmod +x "${target}"
}

_environmart_configure_git() {
  if [ ! -f "${HOME}/.gitconfig" ]; then
    git config --global user.email "mikemartin1090@users.noreply.github.com"
    git config --global user.name "Mike Martin"
    git config --global pull.rebase false
    git config --global init.defaultBranch main
    git config --global url.ssh://git@github.com/.insteadOf https://github.com/
    git config --global core.pager "delta"
    git config --global interactive.diffFilter "delta --color-only"
    git config --global delta.navigate true
    git config --global delta.line-numbers true
    git config --global delta.side-by-side true
    git config --global merge.conflictStyle diff3
    git config --global diff.colorMoved default
  fi
}

_environmart_install_fzf() {
  if _which fzf || [ -d "${HOME}/.fzf" ]; then
    return 0
  fi

  git clone --depth 1 "https://github.com/junegunn/fzf.git" "${HOME}/.fzf" || return 1
  pushd "${HOME}/.fzf" > /dev/null || return 1
  "${HOME}/.fzf/install" --key-bindings --completion --no-update-rc
  local result="$?"
  popd > /dev/null
  return "${result}"
}

_environmart_install_oh_my_zsh() {
  if [ -d "${HOME}/.oh-my-zsh" ]; then
    return 0
  fi

  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
}

_environmart_install_nvm() {
  export NVM_DIR="${NVM_DIR:-${HOME}/.nvm}"

  if [ ! -s "${NVM_DIR}/nvm.sh" ]; then
    PROFILE=/dev/null bash -c "$(curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.1/install.sh)" || return 1
  fi

  _environmart_load_nvm || return 1

  if ! _environmart_has_executable npm; then
    nvm install --lts --default || return 1
    nvm use --silent default > /dev/null || return 1
  fi
}

_environmart_load_nvm() {
  export NVM_DIR="${NVM_DIR:-${HOME}/.nvm}"
  unset -f nvm node npm npx corepack jwt 2> /dev/null || true

  if [ ! -s "${NVM_DIR}/nvm.sh" ]; then
    echo "NVM is not installed. Run environmart_install_tools first." >&2
    return 1
  fi

  . "${NVM_DIR}/nvm.sh"
}

_environmart_use_nvm() {
  _environmart_load_nvm || return 1
  nvm use --silent default > /dev/null 2>&1 || nvm use --silent node > /dev/null 2>&1 || return 1
}

# Keep Node tooling available without paying the NVM startup cost in every shell.
nvm() {
  _environmart_load_nvm || return 1
  nvm "$@"
}

node() {
  _environmart_use_nvm || return 1
  command node "$@"
}

npm() {
  _environmart_use_nvm || return 1
  command npm "$@"
}

npx() {
  _environmart_use_nvm || return 1
  command npx "$@"
}

corepack() {
  _environmart_use_nvm || return 1
  command corepack "$@"
}

jwt() {
  _environmart_use_nvm || return 1
  command jwt "$@"
}

_environmart_install_npm_tools() {
  export NVM_DIR="${NVM_DIR:-${HOME}/.nvm}"

  if [ ! -s "${NVM_DIR}/nvm.sh" ]; then
    _environmart_install_nvm || return 1
  else
    _environmart_load_nvm || return 1
  fi

  if ! _environmart_has_executable npm; then
    nvm install --lts --default || return 1
    nvm use --silent default > /dev/null || return 1
  fi

  _environmart_has_executable npm || return 1

  if ! command npm ls --global --depth=0 jwt-cli > /dev/null 2>&1; then
    command npm install --global jwt-cli
  fi
}

environmart_refresh_completions() {
  local cache_file="${ENVIRONMART_COMPLETION_CACHE:-${HOME}/.cache/environmart}/glgroup.bash"
  local cache_dir="${cache_file%/*}"
  local temporary_file="${cache_file}.$$"

  _which glgroup || return 0
  mkdir -p "${cache_dir}" || return 1
  glgroup bashcomplete > "${temporary_file}" || return 1
  mv "${temporary_file}" "${cache_file}"
}

environmart_load_completions() {
  local cache_file="${ENVIRONMART_COMPLETION_CACHE:-${HOME}/.cache/environmart}/glgroup.bash"

  [ -r "${cache_file}" ] && . "${cache_file}"
}

_environmart_update_reminder_due() {
  local days="${ENVIRONMART_UPDATE_REMINDER_DAYS:-14}"
  local last_update=0
  local now

  case "${days}" in
    ''|*[!0-9]*|0) return 1 ;;
  esac

  if [ -r "${ENVIRONMART_UPDATE_REMINDER_FILE}" ]; then
    read -r last_update < "${ENVIRONMART_UPDATE_REMINDER_FILE}"
  fi

  case "${last_update}" in
    ''|*[!0-9]*) last_update=0 ;;
  esac

  now="$(date +%s)" || return 1
  (( now - last_update >= days * 86400 ))
}

environmart_update_reminder() {
  _environmart_update_reminder_due || return 0

  printf '%b\n' "${yellowb}Environmart update reminder:${end} run ${lightblue}environmart_update${end} when convenient."
  _environmart_record_update >/dev/null 2>&1
}

_environmart_record_update() {
  local marker="${ENVIRONMART_UPDATE_REMINDER_FILE}"
  local directory="${marker%/*}"
  local temporary="${marker}.$$"
  local now

  [ "${directory}" = "${marker}" ] && directory=.
  now="$(date +%s)" || return 1
  mkdir -p "${directory}" || return 1
  printf '%s\n' "${now}" > "${temporary}" || return 1
  mv -f "${temporary}" "${marker}"
}

cat << EOF >> "${ENVIRONMART_HELP_FILE}"
${blue}
${white}## Workstation Maintenance
${blue}
-   ${white}environmart_install_tools  ${blue}
    Install missing workstation dependencies
-   ${white}environmart_update  ${blue}
    Update Homebrew and managed global tools

EOF

# Install missing workstation dependencies without upgrading existing ones.
environmart_install_tools() {
  if [[ "${OSTYPE:-}" == darwin* ]]; then
    _environmart_install_brew_tools || return 1
  fi

  _environmart_install_prettyping || return 1
  _environmart_configure_git || return 1
  _environmart_install_fzf || return 1
  _environmart_install_oh_my_zsh || return 1
  _environmart_install_nvm || return 1
  _environmart_install_npm_tools || return 1
  environmart_refresh_completions || return 1

  echo "Environmart tools installed."
}

# Update Homebrew-managed software only when explicitly requested.
environmart_update() {
  if [[ "${OSTYPE:-}" == darwin* ]]; then
    _environmart_ensure_brew || return 1
    brew update || return 1
    brew upgrade || return 1
    brew upgrade --cask || return 1
    brew cleanup || return 1
  fi

  environmart_install_tools || return 1

  if _which npm; then
    npm update --global jwt-cli || return 1
  fi

  environmart_refresh_completions || return 1
  _environmart_record_update || return 1
}

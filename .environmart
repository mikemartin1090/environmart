#! /usr/bin/env bash
RPROMPT='[%D{%L:%M:%S}] '$RPROMPT

export DIR_REVERTS="${HOME}/reverts"
export DIR_GLG="${HOME}/code/glg"
export DIR_GLG_INFRASTRUCTURE="${DIR_GLG}/aws-infrastructure"
export DIR_CODE="${HOME}/code"
export DIR_PERSONAL="${HOME}/code/public"
export URL_PATH_TO_ENV_FILES="https://raw.githubusercontent.com/mikemartin1090/environmart/master"
export ENVIRONMART_HELP_FILE="/tmp/.environmart.help.md"
export ENVIRONMART_COMPLETION_CACHE="${XDG_CACHE_HOME:-${HOME}/.cache}/environmart"
export ENVIRONMART_UPDATE_REMINDER_DAYS="${ENVIRONMART_UPDATE_REMINDER_DAYS:-14}"
export ENVIRONMART_UPDATE_REMINDER_FILE="${ENVIRONMART_UPDATE_REMINDER_FILE:-${XDG_STATE_HOME:-${HOME}/.local/state}/environmart/last-update}"

#my go path
#TODO: maybe move this elsewhere? Tools? I'll need to do something
# to create the directories we are referencing here:
# mkdir ~/go mkdir ~/go/bin mkdir ~/go/src
export GOPATH=$HOME/go
export PATH=$PATH:$GOPATH/bin

: > "${ENVIRONMART_HELP_FILE}"

ENVIRONMART_FILES_TO_LOAD="${ENVIRONMART_FILES_TO_LOAD:-colors functions aliases tools}"

mkdir -p "${HOME}/run"
for file in $(printf '%s\n' "${ENVIRONMART_FILES_TO_LOAD}"); do
  FILE_CACHE_ALIASES="${HOME}/run/.${file}"
  if [ ! -f "${FILE_CACHE_ALIASES}" ]; then
    curl -fsSL "${URL_PATH_TO_ENV_FILES}/${file}" -o "${FILE_CACHE_ALIASES}" || return 1
  fi
  . "${FILE_CACHE_ALIASES}" || return 1
  echo "${whiteb}$file ${green}Loaded...${end}"
done

echo "${yellowb}Environmart ${green}Loaded...${end}"
echo ""
echo "${whiteb}Type ${lightblue}help${whiteb} for more help"

help() {
  echo -ne "$(sed 's/$/\\n/' "${ENVIRONMART_HELP_FILE}" | sed 's/ /\\a /g')"
}

if type environmart_update_reminder > /dev/null 2>&1; then
  environmart_update_reminder
fi
